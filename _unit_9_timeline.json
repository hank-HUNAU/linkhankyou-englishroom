 "p090": [
  {
   "i": 0,
   "start_s": 8.44,
   "end_s": 11.38,
   "dur_s": 2.94,
   "text": "Wow! What a great smell!",
   "confidence": 1.0
  },
  {
   "i": 1,
   "start_s": 12.14,
   "end_s": 18.24,
   "dur_s": 6.1,
   "text": "Thanks, Mum! It's lasagna. It's in the oven and it's almost ready.",
   "confidence": 1.0
  },
  {
   "i": 2,
   "start_s": 18.84,
   "end_s": 20.44,
   "dur_s": 1.6,
   "text": "Lasagna from the shop?",
   "confidence": 1.0
  },
  {
   "i": 3,
   "start_s": 20.94,
   "end_s": 23.54,
   "dur_s": 2.6,
   "text": "No, Mum. It's my lasagna.",
   "confidence": 1.0
  },
  {
   "i": 4,
   "start_s": 23.54,
   "end_s": 30.78,
   "dur_s": 7.24,
   "text": "It's got meat, pepper, mushrooms, cheese, onion, everything.",
   "confidence": 1.0
  },
  {
   "i": 5,
   "start_s": 31.74,
   "end_s": 34.82,
   "dur_s": 3.08,
   "text": "And we can eat it with a bit of salad.",
   "confidence": 1.0
  },
  {
   "i": 6,
   "start_s": 35.68,
   "end_s": 40.16,
   "dur_s": 4.48,
   "text": "Oh, right! But we? Who's coming for lunch?",
   "confidence": 1.0
  },
  {
   "i": 7,
   "start_s": 41.04,
   "end_s": 47.44,
   "dur_s": 6.4,
   "text": "Mark and Chloe. We want to study together this afternoon and have lunch together first.",
   "confidence": 1.0
  },
  {
   "i": 8,
   "start_s": 48.26,
   "end_s": 49.8,
   "dur_s": 1.54,
   "text": "That's okay, right?",
   "confidence": 1.0
  },
  {
   "i": 9,
   "start_s": 50.54,
   "end_s": 53.52,
   "dur_s": 2.98,
   "text": "Of course, Joe. But...",
   "confidence": 1.0
  },
  {
   "i": 10,
   "start_s": 53.52,
   "end_s": 54.04,
   "dur_s": 0.52,
   "text": "But what, Mum?",
   "confidence": 1.0
  },
  {
   "i": 11,
   "start_s": 54.54,
   "end_s": 58.72,
   "dur_s": 4.18,
   "text": "Well, the thing is, I'd like a nice quiet afternoon.",
   "confidence": 1.0
  },
  {
   "i": 12,
   "start_s": 59.22,
   "end_s": 65.271,
   "dur_s": 6.051,
   "text": "Oh, don't worry, Mum. After lunch, we plan to study upstairs in my room.",
   "confidence": 1.0
  },
  {
   "i": 13,
   "start_s": 66.36,
   "end_s": 68.1,
   "dur_s": 1.74,
   "text": "Oh! It's ready!",
   "confidence": 1.0
  },
  {
   "i": 14,
   "start_s": 68.7,
   "end_s": 73.561,
   "dur_s": 4.861,
   "text": "Be careful, Joe. It's very hot. Can I help you?",
   "confidence": 1.0
  },
  {
   "i": 15,
   "start_s": 73.8,
   "end_s": 81.66,
   "dur_s": 7.86,
   "text": "It's okay, Mum. I can just... Oh, no! My lasagna! It's all over the floor!",
   "confidence": 1.0
  },
  {
   "i": 16,
   "start_s": 82.733,
   "end_s": 83.94,
   "dur_s": 1.207,
   "text": "Now what?",
   "confidence": 1.0
  },
  {
   "i": 17,
   "start_s": 84.54,
   "end_s": 94.06,
   "dur_s": 9.52,
   "text": "Well, first, let's clean it all up. And then, do you and your friends want to go to the new sandwich shop?",
   "confidence": 1.0
  },
  {
   "i": 18,
   "start_s": 94.32,
   "end_s": 100.64,

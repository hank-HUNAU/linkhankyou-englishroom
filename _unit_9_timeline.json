   "start_s": 74.28,
   "end_s": 74.82,
   "dur_s": 0.54,
   "text": "Great.",
   "confidence": 1.0
  },
  {
   "i": 23,
   "start_s": 75.5,
   "end_s": 77.88,
   "dur_s": 2.38,
   "text": "And can Sally and Max come too?",
   "confidence": 1.0
  },

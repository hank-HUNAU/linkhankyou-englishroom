   "start_s": 13.52,
   "end_s": 15.54,
   "dur_s": 2.02,
   "text": "Of course you can. No problem.",
   "confidence": 1.0
  },
  {
   "i": 2,
   "start_s": 16.26,
   "end_s": 17.833,
   "dur_s": 1.573,
   "text": "Would you like some help?",

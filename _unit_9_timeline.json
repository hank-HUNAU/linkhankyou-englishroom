  },
  {
   "i": 5,
   "start_s": 23.32,
   "end_s": 27.42,
   "dur_s": 4.1,
   "text": "No, your mum wants that for the lasagna. Use this cheese.",
   "confidence": 1.0
  },
  {
   "i": 6,
   "start_s": 27.91,
   "end_s": 28.26,
   "dur_s": 0.35,
   "text": "Okay.",
   "confidence": 1.0
  },
  {
   "i": 7,
   "start_s": 28.68,
   "end_s": 32.66,
   "dur_s": 3.98,
   "text": "We need some salad in the sandwiches. Have we got any?",
   "confidence": 1.0
  },
  {
   "i": 8,
   "start_s": 33.1,
   "end_s": 36.98,
   "dur_s": 3.88,
   "text": "There's no cucumber, but there are some tomatoes.",
   "confidence": 1.0
  },
  {
   "i": 9,
   "start_s": 37.8,
   "end_s": 41.12,
   "dur_s": 3.32,
   "text": "Let's have cheese and tomato sandwiches then.",
   "confidence": 1.0
  },
  {
   "i": 10,
   "start_s": 41.72,
   "end_s": 42.284,
   "dur_s": 0.564,
   "text": "Cool.",
   "confidence": 1.0
  },
  {
   "i": 11,
   "start_s": 42.66,
   "end_s": 44.08,
   "dur_s": 1.42,
   "text": "What are you doing, Dad?",
   "confidence": 1.0
  },
  {
   "i": 12,
   "start_s": 44.62,
   "end_s": 49.08,
   "dur_s": 4.46,
   "text": "I'm putting some peanut butter on the bread. It's tastier than butter.",
   "confidence": 1.0
  },
  {
   "i": 13,
   "start_s": 49.44,
   "end_s": 50.32,
   "dur_s": 0.88,
   "text": "Don't do that.",
   "confidence": 1.0
  },
  {
   "i": 14,
   "start_s": 50.86,
   "end_s": 51.4,
   "dur_s": 0.54,
   "text": "Too late.",
   "confidence": 1.0
  },
  {
   "i": 15,
   "start_s": 51.9,
   "end_s": 55.36,
   "dur_s": 3.46,
   "text": "The thing is, Sally is allergic to nuts.",
   "confidence": 1.0
  },
  {
   "i": 16,
   "start_s": 56.0,
   "end_s": 58.08,
   "dur_s": 2.08,
   "text": "Oh no. I'm sorry.",
   "confidence": 1.0
  },
  {
   "i": 17,
   "start_s": 58.723,
   "end_s": 60.74,
   "dur_s": 2.017,
   "text": "Never mind. I can eat these.",
   "confidence": 1.0
  },
  {
   "i": 18,
   "start_s": 61.34,
   "end_s": 63.054,
   "dur_s": 1.714,
   "text": "And you can make some more.",
   "confidence": 1.0
  },
  {
   "i": 19,
   "start_s": 63.28,
   "end_s": 66.94,
   "dur_s": 3.66,
   "text": "We can't make any more. We haven't got any more bread.",
   "confidence": 1.0
  },

   "i": 3,
   "start_s": 18.24,
   "end_s": 20.26,
   "dur_s": 2.02,
   "text": "No, we're okay, thanks.",
   "confidence": 1.0
  },
  {
   "i": 4,
   "start_s": 21.02,
   "end_s": 23.046,
   "dur_s": 2.026,
   "text": "Can we use this cheese, Dad?",

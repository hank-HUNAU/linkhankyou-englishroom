 "sentences": [
  {
   "i": 0,
   "start_s": 10.06,
   "end_s": 11.78,
   "dur_s": 1.72,
   "text": "What are you doing, Lori?"
  },
  {
   "i": 1,
   "start_s": 12.42,
   "end_s": 14.26,
   "dur_s": 1.84,
   "text": "I’m looking for my T-shirt."
  },
  {
   "i": 2,
   "start_s": 15.3,
   "end_s": 15.9,
   "dur_s": 0.6,
   "text": "Your T-shirt?"
  },
  {
   "i": 3,
   "start_s": 16.78,
   "end_s": 17.7,
   "dur_s": 0.92,
   "text": "You’ve got lots!"
  },
  {
   "i": 4,
   "start_s": 18.5,
   "end_s": 20.04,
   "dur_s": 1.54,
   "text": "Which one are you looking for?"
  },
  {
   "i": 5,
   "start_s": 20.42,
   "end_s": 22.48,
   "dur_s": 2.06,
   "text": "The red one with the flower on it."
  },
  {
   "i": 6,
   "start_s": 23.2,
   "end_s": 27.68,
   "dur_s": 4.48,
   "text": "I can’t find it anywhere and I’ve got to go out in five minutes."
  },
  {
   "i": 7,
   "start_s": 28.24,
   "end_s": 29.42,
   "dur_s": 1.18,
   "text": "Where are you going?"
  },
  {
   "i": 8,
   "start_s": 29.42,
   "end_s": 32.14,
   "dur_s": 2.72,
   "text": "To the cinema with Lucy and Darcy."
  },
  {
   "i": 9,
   "start_s": 32.54,
   "end_s": 33.8,
   "dur_s": 1.26,
   "text": "I want to look nice."
  },
  {
   "i": 10,
   "start_s": 34.26,
   "end_s": 36.96,
   "dur_s": 2.7,
   "text": "Oh, I can’t find it!"
  },
  {
   "i": 11,
   "start_s": 37.36,
   "end_s": 39.741,
   "dur_s": 2.381,
   "text": "Do you want to borrow one of mine?"
  },
  {
   "i": 12,
   "start_s": 40.12,
   "end_s": 40.84,
   "dur_s": 0.72,
   "text": "Can I?"
  },
  {
   "i": 13,
   "start_s": 41.88,
   "end_s": 44.22,
   "dur_s": 2.34,
   "text": "Thanks, Olivia, you’re the best."
  },
  {
   "i": 14,
   "start_s": 44.58,
   "end_s": 44.88,
   "dur_s": 0.3,
   "text": "Sure."
  },
  {
   "i": 15,
   "start_s": 45.46,
   "end_s": 47.84,
   "dur_s": 2.38,
   "text": "Just get one from my room but don’t make a mess."
  },
  {
   "i": 16,
   "start_s": 48.3,
   "end_s": 49.06,
   "dur_s": 0.76,
   "text": "Don’t worry."
  },
  {
   "i": 17,
   "start_s": 49.58,
   "end_s": 50.92,
   "dur_s": 1.34,
   "text": "No mess, I promise."
  },
  {
   "i": 18,
   "start_s": 52.7,
   "end_s": 54.84,
   "dur_s": 2.14,
   "text": "Can I borrow your red boots, too?"
  },
  {
   "i": 19,
   "start_s": 55.44,
   "end_s": 57.18,
   "dur_s": 1.74,
   "text": "You mean my new ones?"
  },
  {
   "i": 20,
   "start_s": 57.18,
   "end_s": 59.58,
   "dur_s": 2.4,
   "text": "No, you can’t."
  },
  {
   "i": 21,
   "start_s": 59.72,
   "end_s": 60.82,
   "dur_s": 1.1,
   "text": "Oh no, really?"
  },
  {
   "i": 22,
   "start_s": 61.28,
   "end_s": 62.06,
   "dur_s": 0.78,
   "text": "Why not?"
  },
  {
   "i": 23,
   "start_s": 62.48,
   "end_s": 63.36,
   "dur_s": 0.88,
   "text": "They’re really cool!"
  },
  {
   "i": 24,
   "start_s": 63.88,
   "end_s": 74.34,
   "dur_s": 10.46,
   "text": "I know I am the world’s best sister, Lori, but there are some times when I have to say ‘no’!"
  },
  {
   "i": 25,
   "start_s": 75.92,
   "end_s": 76.56,
   "dur_s": 0.64,
   "text": "Mum?"
  },
  {
   "i": 26,
   "start_s": 76.96,
   "end_s": 79.34,
   "dur_s": 2.38,
   "text": "Have we got any plans this weekend?"
  },
  {
   "i": 27,
   "start_s": 80.06,
   "end_s": 81.48,
   "dur_s": 1.42,
   "text": "I don’t think so."
  },
  {
   "i": 28,
   "start_s": 81.92,
   "end_s": 82.26,
   "dur_s": 0.34,
   "text": "Why?"
  },
  {
   "i": 29,
   "start_s": 82.64,
   "end_s": 84.6,
   "dur_s": 1.96,
   "text": "There’s a party at Nathan’s place."
  },
  {
   "i": 30,
   "start_s": 85.14,
   "end_s": 85.76,
   "dur_s": 0.62,
   "text": "Can I go?"
  },
  {
   "i": 31,
   "start_s": 85.76,
   "end_s": 88.363,
   "dur_s": 2.603,
   "text": "Well, that depends …"
  },
  {
   "i": 32,
   "start_s": 88.5,
   "end_s": 89.12,
   "dur_s": 0.62,
   "text": "When is it?"
  },
  {
   "i": 33,
   "start_s": 89.38,
   "end_s": 90.12,
   "dur_s": 0.74,
   "text": "Saturday night."
  },
  {
   "i": 34,
   "start_s": 90.52,
   "end_s": 90.94,
   "dur_s": 0.42,
   "text": "8 o’clock."
  },
  {
   "i": 35,
   "start_s": 91.86,
   "end_s": 92.32,
   "dur_s": 0.46,
   "text": "Sure."
  },
  {
   "i": 36,
   "start_s": 92.64,
   "end_s": 93.16,
   "dur_s": 0.52,
   "text": "That’s fine."
  },
  {
   "i": 37,
   "start_s": 93.86,
   "end_s": 95.2,
   "dur_s": 1.34,
   "text": "Where does Nathan live?"
  },
  {
   "i": 38,
   "start_s": 95.66,
   "end_s": 96.68,
   "dur_s": 1.02,
   "text": "He’s out in Foxton."
  },
  {
   "i": 39,
   "start_s": 97.361,
   "end_s": 99.76,
   "dur_s": 2.399,
   "text": "His family have got an amazing house."
  },
  {
   "i": 40,
   "start_s": 100.3,
   "end_s": 101.06,
   "dur_s": 0.76,
   "text": "Foxton?"
  },
  {
   "i": 41,
   "start_s": 101.68,
   "end_s": 104.06,
   "dur_s": 2.38,
   "text": "That’s five kilometres from here."
  },
  {
   "i": 42,
   "start_s": 104.78,
   "end_s": 108.78,
   "dur_s": 4.0,
   "text": "And I guess there are no buses at that time of night."
  },
  {
   "i": 43,
   "start_s": 109.34,
   "end_s": 112.408,
   "dur_s": 3.068,
   "text": "Umm, no, I don’t think so."
  },
  {
   "i": 44,
   "start_s": 112.756,
   "end_s": 116.04,
   "dur_s": 3.284,
   "text": "Well, no actually, there aren’t any buses, no."
  },
  {
   "i": 45,
   "start_s": 116.52,
   "end_s": 116.982,
   "dur_s": 0.462,
   "text": "Right."
  },
  {
   "i": 46,
   "start_s": 117.7,
   "end_s": 118.68,
   "dur_s": 0.98,
   "text": "So come on."
  },
  {
   "i": 47,
   "start_s": 119.351,
   "end_s": 121.1,
   "dur_s": 1.749,
   "text": "Let’s hear the next question, Tom."
  },
  {
   "i": 48,
   "start_s": 122.0,
   "end_s": 123.26,
   "dur_s": 1.26,
   "text": "Any chance of a lift, Mum?"
  },
  {
   "i": 49,
   "start_s": 123.66,
   "end_s": 127.94,
   "dur_s": 4.28,
   "text": "Of course, but I need to pick you up by midnight at the latest."
  },
  {
   "i": 50,
   "start_s": 128.5,
   "end_s": 129.96,
   "dur_s": 1.46,
   "text": "I need my sleep, you know."
  },
  {
   "i": 51,
   "start_s": 130.58,
   "end_s": 131.529,
   "dur_s": 0.949,
   "text": "No problem, Mum."
  },
  {
   "i": 52,
   "start_s": 131.84,
   "end_s": 132.74,
   "dur_s": 0.9,
   "text": "Thanks so much!"
  }
 ]
}